<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Material Design 3 Dark Theme Tokens -->
    <!-- Primary: Indigo Blue -->
    <Color x:Key="Primary">#6366F1</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryContainer">#4F46E5</Color>
    <Color x:Key="OnPrimaryContainer">#F0F4FF</Color>

    <!-- Secondary: Purple -->
    <Color x:Key="Secondary">#7C3AED</Color>
    <Color x:Key="OnSecondary">#FFFFFF</Color>
    <Color x:Key="SecondaryContainer">#6D28D9</Color>
    <Color x:Key="OnSecondaryContainer">#F3E8FF</Color>

    <!-- Tertiary: Cyan -->
    <Color x:Key="Tertiary">#06B6D4</Color>
    <Color x:Key="OnTertiary">#FFFFFF</Color>
    <Color x:Key="TertiaryContainer">#0891B2</Color>
    <Color x:Key="OnTertiaryContainer">#CFFAFE</Color>

    <!-- Background Colors -->
    <Color x:Key="AppBg">#121212</Color>
    <Color x:Key="AppSurface">#1E1E1E</Color>
    <Color x:Key="AppSurface2">#282828</Color>
    <Color x:Key="AppPanel">#1F1F1F</Color>
    <Color x:Key="AppBorder">#3F3F3F</Color>
    <Color x:Key="AppBorderStrong">#4A4A4A</Color>
    <Color x:Key="AppSep">#2A2A2A</Color>

    <!-- Accent & Semantic -->
    <Color x:Key="AppAccent">#6366F1</Color>
    <Color x:Key="AppAccentDim">#4F46E5</Color>
    <Color x:Key="AppAccentSoft">#3730A3</Color>
    <Color x:Key="AppAccentGlow">#6366F144</Color>
    <Color x:Key="AppAccentLight">#818CF8</Color>

    <!-- Text Colors -->
    <Color x:Key="AppText1">#FFFBFE</Color>
    <Color x:Key="AppText2">#C9C9D3</Color>
    <Color x:Key="AppText3">#79747E</Color>

    <!-- Semantic Colors -->
    <Color x:Key="AppSuccess">#4CAF50</Color>
    <Color x:Key="AppWarning">#FB8C00</Color>
    <Color x:Key="AppDanger">#E53935</Color>

    <!-- Editor Specific -->
    <Color x:Key="EditorBg">#0A0A0A</Color>
    <Color x:Key="EditorSurface">#151515</Color>

    <!-- ── Vision Edit Editor Tokens ──────────────────────────────────────
         These are used by EditorView, EditorPage, ChatView, ChatPage.
         Mapped to the current indigo/purple App palette.
    ──────────────────────────────────────────────────────────────────── -->
    <!-- Text hierarchy -->
    <Color x:Key="VE_Text1">#FFFBFE</Color>
    <Color x:Key="VE_Text2">#C9C9D3</Color>
    <Color x:Key="VE_Text3">#79747E</Color>
    <Color x:Key="VE_Text4">#4A4A58</Color>

    <!-- Accent: indigo-based (replaces former gold) -->
    <Color x:Key="VE_Gold">#818CF8</Color>
    <Color x:Key="VE_GoldDim">#6366F1</Color>
    <Color x:Key="VE_GoldMid">#4F46E5</Color>
    <Color x:Key="VE_GoldFaint">#6366F130</Color>

    <!-- Background surfaces -->
    <Color x:Key="VE_BgBase">#0D0D11</Color>
    <Color x:Key="VE_BgPanel">#1A1A1F</Color>
    <Color x:Key="VE_BgCard">#1E1E2A</Color>
    <Color x:Key="VE_BgInput">#18181E</Color>

    <!-- Borders -->
    <Color x:Key="VE_Border2">#2A2A38</Color>

    <!-- Semantic -->
    <Color x:Key="VE_Error">#E53935</Color>
    <Color x:Key="VE_ErrorDim">#3B1212</Color>

    <!-- Grayscale -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#EEEEEE</Color>
    <Color x:Key="Gray300">#E0E0E0</Color>
    <Color x:Key="Gray400">#BDBDBD</Color>
    <Color x:Key="Gray500">#9E9E9E</Color>
    <Color x:Key="Gray600">#757575</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#0A0A0A</Color>

    <!-- MAUI Required Keys -->
    <Color x:Key="PrimaryDark">#818CF8</Color>
    <Color x:Key="PrimaryDarkText">#FFFBFE</Color>
    <Color x:Key="SecondaryDarkText">#F3E8FF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
