<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Vision_Edit.ViewModels"
             x:Class="Vision_Edit.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="Login">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label Text="Sign in"
                   Style="{StaticResource Headline}" />

            <Label Text="Enter your credentials to continue."
                   Opacity="0.7" />

            <BoxView HeightRequest="1" Opacity="0.15" />

            <!-- Username -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Username" FontAttributes="Bold" />
                <Entry x:Name="UsernameEntry"
                       Placeholder="Username"
                       ClearButtonVisibility="WhileEditing"
                       ReturnType="Next" />
            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Password" FontAttributes="Bold" />
                <Entry x:Name="PasswordEntry"
                       Placeholder="••••••••"
                       IsPassword="True"
                       ClearButtonVisibility="WhileEditing"
                       ReturnType="Done" />
            </VerticalStackLayout>

            <Button Text="Login"
                    x:Name="LoginButton"
                    Margin="0,10,0,0"
                    Command="{Binding LoginCommand}"
                    />

            <Button Text="Register"
                    x:Name="RegisterButton"
                    Opacity="0.9"
                    Command="{Binding RedirectToRegisterPageCommand}" 
                    />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>