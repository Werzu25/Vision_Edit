<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vision_Edit.Views.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0A0A0A">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Colors -->
            <Color x:Key="BackgroundDeep">#0A0A0A</Color>
            <Color x:Key="BackgroundCard">#111111</Color>
            <Color x:Key="AccentGold">#C8A97E</Color>
            <Color x:Key="AccentGoldDim">#7A6248</Color>
            <Color x:Key="TextPrimary">#F0ECE4</Color>
            <Color x:Key="TextSecondary">#787066</Color>
            <Color x:Key="TextMuted">#3D3A35</Color>
            <Color x:Key="BorderSubtle">#1E1C18</Color>
            <Color x:Key="InputBackground">#161411</Color>
            <Color x:Key="DividerColor">#252320</Color>

            <!-- Entry Style -->
            <Style x:Key="StyledEntry" TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="FontFamily" Value="SpaceMono"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <!-- Primary Button Style -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentGold}"/>
                <Setter Property="TextColor" Value="#0A0A0A"/>
                <Setter Property="FontFamily" Value="SpaceMonoBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CharacterSpacing" Value="3"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="HeightRequest" Value="52"/>
            </Style>

            <!-- Ghost Button Style -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontFamily" Value="SpaceMono"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CharacterSpacing" Value="2"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*, Auto">

        <!-- Background film grain / texture overlay (decorative) -->
        <BoxView Grid.RowSpan="2"
                 BackgroundColor="#0A0A0A"
                 Opacity="1"/>

        <!-- Top accent line -->
        <BoxView Grid.Row="0"
                 Grid.RowSpan="2"
                 HeightRequest="1"
                 BackgroundColor="{StaticResource AccentGold}"
                 VerticalOptions="Start"
                 Opacity="0.6"/>

        <!-- Main scroll container -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="36,64,36,0"
                                 Spacing="0">

                <!-- LOGO / WORDMARK SECTION -->
                <Grid RowDefinitions="Auto,Auto,Auto"
                      Margin="0,0,0,56">

                    <!-- Decorative corner marks -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="16,*,16"
                          HeightRequest="16"
                          Margin="0,0,0,12">
                        <BoxView Grid.Column="0"
                                 HeightRequest="1"
                                 WidthRequest="16"
                                 BackgroundColor="{StaticResource AccentGoldDim}"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Center"/>
                        <BoxView Grid.Column="2"
                                 HeightRequest="1"
                                 WidthRequest="16"
                                 BackgroundColor="{StaticResource AccentGoldDim}"
                                 HorizontalOptions="End"
                                 VerticalOptions="Center"/>
                    </Grid>

                    <!-- App name -->
                    <Label Grid.Row="1"
                           Text="VISION"
                           FontFamily="DisplayFont"
                           FontSize="52"
                           CharacterSpacing="14"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           Margin="0"/>

                    <!-- Subtitle wordmark -->
                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,Auto,*"
                          Margin="0,4,0,0">
                        <BoxView Grid.Column="0"
                                 HeightRequest="1"
                                 BackgroundColor="{StaticResource DividerColor}"
                                 VerticalOptions="Center"
                                 Margin="0,0,12,0"/>
                        <Label Grid.Column="1"
                               Text="EDIT"
                               FontFamily="SpaceMono"
                               FontSize="11"
                               CharacterSpacing="8"
                               TextColor="{StaticResource AccentGold}"
                               VerticalOptions="Center"/>
                        <BoxView Grid.Column="2"
                                 HeightRequest="1"
                                 BackgroundColor="{StaticResource DividerColor}"
                                 VerticalOptions="Center"
                                 Margin="12,0,0,0"/>
                    </Grid>
                </Grid>

                <!-- TAGLINE -->
                <Label Text="Professional. Precise. Yours."
                       FontFamily="SerifFont"
                       FontSize="15"
                       FontAttributes="Italic"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"
                       Margin="0,0,0,48"/>

                <!-- LOGIN FORM CARD -->
                <Border BackgroundColor="{StaticResource BackgroundCard}"
                        Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="3"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Padding="28,32,28,32"
                                        Spacing="0">

                        <!-- SECTION LABEL -->
                        <Label Text="SIGN IN"
                               FontFamily="SpaceMono"
                               FontSize="10"
                               CharacterSpacing="5"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,0,0,28"/>

                        <!-- USERNAME FIELD -->
                        <Label Text="USERNAME"
                               FontFamily="SpaceMono"
                               FontSize="9"
                               CharacterSpacing="3"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,0,0,8"/>

                        <Border BackgroundColor="{StaticResource InputBackground}"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeThickness="1"
                                Margin="0,0,0,20"
                                Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="2"/>
                            </Border.StrokeShape>
                            <Entry x:Name="UsernameEntry"
                                   Style="{StaticResource StyledEntry}"
                                   Placeholder="your username"
                                   ReturnType="Next"
                                   HeightRequest="48"
                                   Text="{Binding Username}"/>
                        </Border>

                        <!-- PASSWORD FIELD -->
                        <Label Text="PASSWORD"
                               FontFamily="SpaceMono"
                               FontSize="9"
                               CharacterSpacing="3"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,0,0,8"/>

                        <Border BackgroundColor="{StaticResource InputBackground}"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeThickness="1"
                                Margin="0,0,0,32"
                                Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="2"/>
                            </Border.StrokeShape>
                            <Entry x:Name="PasswordEntry"
                                   Style="{StaticResource StyledEntry}"
                                   Placeholder="••••••••••••"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   HeightRequest="48"
                                   Text="{Binding Password}"/>
                        </Border>

                        <!-- ERROR MESSAGE -->
                        <Label Text="{Binding ErrorMessage}"
                               FontFamily="SpaceMono"
                               FontSize="12"
                               TextColor="#C0553A"
                               HorizontalOptions="Center"
                               IsVisible="{Binding HasError}"
                               Margin="0,0,0,16"/>

                        <!-- SIGN IN BUTTON -->
                        <Button Text="ENTER"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsNotLoading}"
                                Margin="0,0,0,0"/>

                        <!-- LOADING INDICATOR -->
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="{StaticResource AccentGold}"
                                           HorizontalOptions="Center"
                                           Margin="0,16,0,0"
                                           HeightRequest="24"
                                           WidthRequest="24"/>

                    </VerticalStackLayout>
                </Border>

                <!-- SIGN UP PROMPT -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Margin="0,32,0,40"
                                       Spacing="4">
                    <Label Text="No account yet?"
                           FontFamily="SpaceMono"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"/>
                    <Label Text="Create one →"
                           FontFamily="SpaceMono"
                           FontSize="12"
                           TextColor="{StaticResource AccentGold}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM LEGAL BAR -->
        <VerticalStackLayout Grid.Row="1"
                             BackgroundColor="#0A0A0A"
                             Padding="36,16,36,32"
                             Spacing="4">
            <BoxView HeightRequest="1"
                     BackgroundColor="{StaticResource DividerColor}"
                     Margin="0,0,0,12"/>
            <Label Text="By signing in you agree to our Terms of Use and Privacy Policy."
                   FontFamily="SpaceMono"
                   FontSize="9"
                   CharacterSpacing="1"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Label Text="© 2026 Vision Edit Studio"
                   FontFamily="SpaceMono"
                   FontSize="9"
                   CharacterSpacing="1"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
