<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Vision_Edit.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Vision_Edit.Views.EditorView"
             x:DataType="viewmodels:EditorViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="Invert" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="0" BackgroundColor="Transparent">

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 0  —  TOOLBAR
        ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource VE_BgPanel}"
                Stroke="{StaticResource VE_Border2}"
                StrokeThickness="0,0,0,1"
                Padding="10,0">
            <Border.StrokeShape><RoundRectangle CornerRadius="3,3,0,0"/></Border.StrokeShape>

            <!--  Title | OPEN  SAVE  ···  •  |  − size +  -->
            <Grid ColumnDefinitions="*,1,Auto,4,Auto,4,Auto,8,Auto,8,Auto"
                  HeightRequest="38"
                  VerticalOptions="Center">

                <!-- Document title -->
                <Entry Grid.Column="0"
                       Text="{Binding DocumentTitle}"
                       Placeholder="Untitled"
                       BackgroundColor="Transparent"
                       TextColor="{StaticResource VE_Text1}"
                       PlaceholderColor="{StaticResource VE_Text4}"
                       FontFamily="OpenSansSemibold"
                       FontSize="12"
                       MinimumHeightRequest="0"
                       MinimumWidthRequest="0"
                       ClearButtonVisibility="WhileEditing"
                       VerticalOptions="Center"/>

                <!-- Divider -->
                <BoxView Grid.Column="1"
                         WidthRequest="1"
                         HeightRequest="16"
                         BackgroundColor="{StaticResource VE_Border2}"
                         VerticalOptions="Center"/>

                <!-- OPEN -->
                <Button Grid.Column="2"
                        Text="OPEN"
                        Command="{Binding LoadDocumentCommand}"
                        Style="{StaticResource VE_BtnIcon}"
                        HeightRequest="24"
                        WidthRequest="42"
                        FontSize="8"
                        CharacterSpacing="2"/>

                <!-- SAVE -->
                <Button Grid.Column="4"
                        Text="SAVE"
                        Command="{Binding SaveDocumentCommand}"
                        Style="{StaticResource VE_BtnPrimary}"
                        HeightRequest="24"
                        WidthRequest="46"
                        FontSize="8"
                        CharacterSpacing="2"
                        Padding="0"/>

                <!-- Save as (···) -->
                <Button Grid.Column="6"
                        Text="···"
                        Command="{Binding SaveDocumentAsCommand}"
                        Style="{StaticResource VE_BtnIcon}"
                        FontSize="13"
                        HeightRequest="24"
                        WidthRequest="24"/>

                <!-- Unsaved dot -->
                <Border Grid.Column="8"
                        WidthRequest="5"
                        HeightRequest="5"
                        BackgroundColor="{StaticResource VE_GoldDim}"
                        IsVisible="{Binding HasUnsavedChanges}"
                        VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                </Border>

                <!-- Font-size stepper -->
                <HorizontalStackLayout Grid.Column="10"
                                       Spacing="0"
                                       VerticalOptions="Center">
                    <Button Text="−"
                            Command="{Binding DecreaseFontSizeCommand}"
                            Style="{StaticResource VE_BtnIcon}"
                            HeightRequest="24"
                            WidthRequest="24"/>
                    <Label Text="{Binding FontSize, StringFormat='{0:F0}'}"
                           WidthRequest="24"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           FontFamily="OpenSansSemibold"
                           FontSize="10"
                           TextColor="{StaticResource VE_Text3}"/>
                    <Button Text="+"
                            Command="{Binding IncreaseFontSizeCommand}"
                            Style="{StaticResource VE_BtnIcon}"
                            HeightRequest="24"
                            WidthRequest="24"/>
                </HorizontalStackLayout>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 1  —  EDITOR SURFACE
        ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource VE_BgBase}"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="24,16">
            <Border.StrokeShape><RoundRectangle CornerRadius="0"/></Border.StrokeShape>
            <Editor x:Name="MainEditor"
                    Text="{Binding Text, Mode=TwoWay}"
                    CursorPosition="{Binding CursorPosition, Mode=TwoWay}"
                    SelectionLength="{Binding SelectionLength, Mode=TwoWay}"
                    FontSize="{Binding FontSize}"
                    TextColor="{Binding FontColor}"
                    FontFamily="OpenSansRegular"
                    BackgroundColor="Transparent"
                    IsReadOnly="False"
                    IsEnabled="True"
                    Placeholder="Begin your document…"
                    PlaceholderColor="{StaticResource VE_Text4}"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    AutoSize="Disabled"/>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 2  —  AI COMPLETION PANEL  (only shown when active)
        ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource VE_BgCard}"
                Stroke="{StaticResource VE_GoldDim}"
                StrokeThickness="0,1,0,0"
                IsVisible="{Binding IsCompletionVisible}"
                Padding="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="0"/></Border.StrokeShape>

            <Grid ColumnDefinitions="36,1,*,Auto" HeightRequest="32">

                <!-- AI badge / spinner -->
                <Grid Grid.Column="0" BackgroundColor="{StaticResource VE_BgPanel}">
                    <ActivityIndicator IsRunning="{Binding IsLoadingCompletion}"
                                       IsVisible="{Binding IsLoadingCompletion}"
                                       Color="{StaticResource VE_GoldDim}"
                                       WidthRequest="12"
                                       HeightRequest="12"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                    <Label Text="AI"
                           IsVisible="{Binding IsLoadingCompletion, Converter={StaticResource Invert}}"
                           FontFamily="OpenSansSemibold"
                           FontSize="7"
                           CharacterSpacing="2"
                           TextColor="{StaticResource VE_GoldDim}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Grid>

                <BoxView Grid.Column="1"
                         WidthRequest="1"
                         BackgroundColor="{StaticResource VE_Border2}"
                         VerticalOptions="Fill"/>

                <!-- Suggestion text -->
                <Label Grid.Column="2"
                       Text="{Binding CompletionSuggestion}"
                       TextColor="{StaticResource VE_Text3}"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       FontAttributes="Italic"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       VerticalOptions="Center"
                       Margin="10,0"/>

                <!-- Accept / dismiss buttons -->
                <HorizontalStackLayout Grid.Column="3"
                                       Spacing="4"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0">
                    <Border BackgroundColor="Transparent"
                            Stroke="{StaticResource VE_GoldDim}"
                            StrokeThickness="1"
                            Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="2"/></Border.StrokeShape>
                        <Button Text="↹ Accept"
                                Command="{Binding AcceptCompletionCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource VE_Gold}"
                                FontFamily="OpenSansSemibold"
                                FontSize="8"
                                CharacterSpacing="1"
                                HeightRequest="22"
                                Padding="8,0"
                                CornerRadius="2"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"/>
                    </Border>
                    <Button Text="✕"
                            Command="{Binding DismissCompletionCommand}"
                            Style="{StaticResource VE_BtnIcon}"
                            TextColor="{StaticResource VE_Text4}"
                            FontSize="10"
                            WidthRequest="22"
                            HeightRequest="22"
                            MinimumHeightRequest="0"
                            MinimumWidthRequest="0"/>
                </HorizontalStackLayout>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 3  —  STATUS BAR
             Layout:  [word count · char count]  ·  [Ln / Col]  ·  [● UNSAVED]
        ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3"
              BackgroundColor="{StaticResource VE_BgPanel}"
              HeightRequest="20">

            <!-- Top border line -->
            <BoxView VerticalOptions="Start"
                     HeightRequest="1"
                     BackgroundColor="{StaticResource VE_Border2}"/>

            <!-- Content -->
            <Grid ColumnDefinitions="Auto,*,Auto,16,Auto"
                  Padding="12,0"
                  VerticalOptions="Center">

                <!-- Word + char count -->
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <Label Text="{Binding WordCount}"
                           FontFamily="OpenSansRegular"
                           FontSize="9"
                           TextColor="{StaticResource VE_Text4}"
                           VerticalOptions="Center"/>
                    <BoxView WidthRequest="1"
                             HeightRequest="8"
                             BackgroundColor="{StaticResource VE_Border2}"
                             VerticalOptions="Center"/>
                    <Label Text="{Binding CharCount}"
                           FontFamily="OpenSansRegular"
                           FontSize="9"
                           TextColor="{StaticResource VE_Text4}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Cursor position -->
                <Label Grid.Column="2"
                       Text="{Binding CursorInfo}"
                       FontFamily="OpenSansRegular"
                       FontSize="9"
                       TextColor="{StaticResource VE_Text4}"
                       VerticalOptions="Center"/>

                <!-- Unsaved indicator -->
                <HorizontalStackLayout Grid.Column="4"
                                       IsVisible="{Binding HasUnsavedChanges}"
                                       Spacing="4"
                                       VerticalOptions="Center">
                    <Border WidthRequest="5"
                            HeightRequest="5"
                            BackgroundColor="{StaticResource VE_GoldDim}"
                            VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                    </Border>
                    <Label Text="UNSAVED"
                           FontFamily="OpenSansSemibold"
                           FontSize="7"
                           CharacterSpacing="2"
                           TextColor="{StaticResource VE_GoldDim}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

            </Grid>
        </Grid>

    </Grid>
</ContentView>
