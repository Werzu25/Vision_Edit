<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Vision_Edit.Views"
             xmlns:viewmodels="clr-namespace:Vision_Edit.ViewModels"
             x:Class="Vision_Edit.Views.ChatPage"
             BackgroundColor="{StaticResource VE_BgBase}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="52,*" RowSpacing="0">

        <!-- ── TOP CHROME BAR ── -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource VE_BgPanel}"
                Stroke="{StaticResource VE_Border2}"
                StrokeThickness="0,0,0,1"
                Padding="20,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">

                <!-- Left: App name + context -->
                <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                    <BoxView WidthRequest="3"
                             HeightRequest="16"
                             BackgroundColor="{StaticResource VE_GoldDim}"
                             VerticalOptions="Center"/>
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label Text="VISION EDIT"
                               FontFamily="OpenSansSemibold"
                               FontSize="10"
                               CharacterSpacing="4"
                               TextColor="{StaticResource VE_Text1}"/>
                        <Label Text="AI CHAT"
                               FontFamily="OpenSansSemibold"
                               FontSize="8"
                               CharacterSpacing="3"
                               TextColor="{StaticResource VE_GoldDim}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Right: Switch to Editor -->
                <Border Grid.Column="2"
                        BackgroundColor="Transparent"
                        Stroke="{StaticResource VE_Border2}"
                        StrokeThickness="1"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="3"/>
                    </Border.StrokeShape>
                    <Button Text="OPEN EDITOR →"
                            Command="{Binding OpenEditorCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource VE_Text3}"
                            FontFamily="OpenSansSemibold"
                            FontSize="9"
                            CharacterSpacing="2"
                            HeightRequest="32"
                            Padding="14,0"
                            CornerRadius="3"/>
                </Border>
            </Grid>
        </Border>

        <!-- ── CHAT CONTENT AREA ── -->
        <Grid Grid.Row="1" Padding="16,12,16,0">
            <Border BackgroundColor="{StaticResource VE_BgBase}"
                    Stroke="{StaticResource VE_Border2}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4,4,0,0"/>
                </Border.StrokeShape>
                <views:ChatView x:Name="ChatArea" VerticalOptions="Fill"/>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
