<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Vision_Edit.ViewModels"
             x:Class="Vision_Edit.Views.RegistrationPage"
             x:DataType="viewmodels:RegistrationViewModel"
             Title="Register"
             BackgroundColor="{StaticResource AppBg}">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0B15" Offset="0.0" />
            <GradientStop Color="#09090E" Offset="0.6" />
            <GradientStop Color="#12132A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <Grid Padding="24,36">
            <Border Stroke="{StaticResource AppBorderStrong}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource AppPanel}"
                    Padding="22"
                    MaximumWidthRequest="500"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <VerticalStackLayout Spacing="12">
                    <Label Text="Create account"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AppText1}" />

                    <Label Text="Register to sync and save your documents."
                           TextColor="{StaticResource AppText2}"
                           FontSize="13" />

                    <BoxView HeightRequest="1" Color="{StaticResource AppBorder}" Margin="0,4,0,6" />

                    <Label Text="Username" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource AppText2}" />
                    <Border Stroke="{StaticResource AppBorder}" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource AppSurface}" Padding="12,6">
                        <Entry Placeholder="Username"
                               Text="{Binding Username}"
                               TextColor="{StaticResource AppText1}"
                               PlaceholderColor="{StaticResource AppText3}"
                               ClearButtonVisibility="WhileEditing"
                               ReturnType="Next" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="First name" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource AppText2}" />
                            <Border Stroke="{StaticResource AppBorder}" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource AppSurface}" Padding="12,6">
                                <Entry Placeholder="First name"
                                       Text="{Binding FirstName}"
                                       TextColor="{StaticResource AppText1}"
                                       PlaceholderColor="{StaticResource AppText3}"
                                       ClearButtonVisibility="WhileEditing"
                                       ReturnType="Next" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Last name" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource AppText2}" />
                            <Border Stroke="{StaticResource AppBorder}" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource AppSurface}" Padding="12,6">
                                <Entry Placeholder="Last name"
                                       Text="{Binding LastName}"
                                       TextColor="{StaticResource AppText1}"
                                       PlaceholderColor="{StaticResource AppText3}"
                                       ClearButtonVisibility="WhileEditing"
                                       ReturnType="Next" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Email" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource AppText2}" />
                    <Border Stroke="{StaticResource AppBorder}" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource AppSurface}" Padding="12,6">
                        <Entry Placeholder="name@example.com"
                               Text="{Binding Email}"
                               Keyboard="Email"
                               TextColor="{StaticResource AppText1}"
                               PlaceholderColor="{StaticResource AppText3}"
                               ClearButtonVisibility="WhileEditing"
                               ReturnType="Next" />
                    </Border>

                    <Label Text="Password" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource AppText2}" />
                    <Border Stroke="{StaticResource AppBorder}" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource AppSurface}" Padding="12,6">
                        <Entry Placeholder="••••••••"
                               Text="{Binding Password}"
                               IsPassword="True"
                               TextColor="{StaticResource AppText1}"
                               PlaceholderColor="{StaticResource AppText3}"
                               ClearButtonVisibility="WhileEditing"
                               ReturnType="Done" />
                    </Border>

                    <Button Text="Register"
                            x:Name="RegisterButton"
                            HeightRequest="44"
                            FontAttributes="Bold"
                            Margin="0,8,0,0"
                            BackgroundColor="{StaticResource AppAccent}"
                            Command="{Binding RegisterCommand}" />

                    <Button Text="Back"
                            x:Name="SwitchToMainPageButton"
                            HeightRequest="42"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource AppBorderStrong}"
                            BorderWidth="1"
                            TextColor="{StaticResource AppText2}"
                            Command="{Binding RedirectToMainPageCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
