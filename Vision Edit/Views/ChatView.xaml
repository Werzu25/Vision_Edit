<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Vision_Edit.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:ChatViewModel"
             x:Class="Vision_Edit.Views.ChatView">

    <Grid RowDefinitions="54,*,Auto,26" RowSpacing="0" BackgroundColor="Transparent">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Padding="12,8" BackgroundColor="{StaticResource AppPanel}">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="Vision AI" TextColor="{StaticResource AppText1}" FontAttributes="Bold" FontSize="13" />
                <Border Padding="6,2" Stroke="{StaticResource AppBorderStrong}" StrokeShape="RoundRectangle 5" BackgroundColor="{StaticResource AppSurface}">
                    <Label Text="gpt-4o" FontSize="10" TextColor="{StaticResource AppText3}" />
                </Border>
            </HorizontalStackLayout>

            <ActivityIndicator Grid.Column="1"
                               IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource AppAccent}"
                               HeightRequest="16"
                               WidthRequest="16"
                               VerticalOptions="Center"
                               Margin="0,0,8,0" />

            <Button Grid.Column="2"
                    Text="Clear"
                    Command="{Binding ClearChatCommand}"
                    HeightRequest="28"
                    Padding="10,0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource AppText3}" />
        </Grid>

        <Border Grid.Row="1"
                Margin="10,8,10,8"
                Stroke="{StaticResource AppBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource EditorBg}">
            <CollectionView x:Name="MessagesView"
                            ItemsSource="{Binding Messages}"
                            VerticalOptions="Fill"
                            BackgroundColor="Transparent">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ChatMessage">
                        <Grid ColumnDefinitions="*,*" Padding="10,2">
                            <Border Grid.Column="0"
                                    IsVisible="{Binding IsUser, Converter={toolkit:InvertedBoolConverter}}"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 12,12,12,5"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource AppBorder}"
                                    BackgroundColor="{StaticResource AppSurface}"
                                    Margin="0,0,8,0">
                                <Label Text="{Binding Content}" TextColor="{StaticResource AppText1}" FontSize="13" LineBreakMode="WordWrap" />
                            </Border>

                            <Border Grid.Column="1"
                                    IsVisible="{Binding IsUser}"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 12,12,5,12"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource AppAccentDim}"
                                    Margin="8,0,0,0">
                                <Label Text="{Binding Content}" TextColor="#E5E6FF" FontSize="13" LineBreakMode="WordWrap" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="8" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </Border>

        <Border Grid.Row="2"
                Margin="10,0,10,8"
                Padding="6"
                Stroke="{StaticResource AppBorderStrong}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource AppSurface}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Editor x:Name="InputEditor"
                        Grid.Column="0"
                        Text="{Binding UserInput, Mode=TwoWay}"
                        Placeholder="Ask anything..."
                        PlaceholderColor="{StaticResource AppText3}"
                        TextColor="{StaticResource AppText1}"
                        BackgroundColor="Transparent"
                        FontSize="13"
                        MinimumHeightRequest="44"
                        MaximumHeightRequest="130"
                        AutoSize="TextChanges"
                        Margin="8,2,2,2" />

                <Button Grid.Column="1"
                        Text="➤"
                        Command="{Binding GetApiContentCommand}"
                        BackgroundColor="{StaticResource AppAccent}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="9"
                        HeightRequest="38"
                        WidthRequest="38"
                        Padding="0"
                        VerticalOptions="End"
                        Margin="0,0,2,2" />
            </Grid>
        </Border>

        <Label Grid.Row="3"
               Text="Tip: highlight text in editor and then send your prompt"
               TextColor="{StaticResource AppText3}"
               FontSize="10"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               BackgroundColor="{StaticResource AppPanel}" />

    </Grid>
</ContentView>
