<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vision_Edit.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0A0A0A"
             Title="Vision Edit">

    <Grid RowDefinitions="*, Auto">

        <!-- Top accent line -->
        <BoxView Grid.RowSpan="2"
                 HeightRequest="1"
                 BackgroundColor="{StaticResource VE_Gold}"
                 VerticalOptions="Start"
                 Opacity="0.5"/>

        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="36,64,36,0" Spacing="0">

                <!-- ── WORDMARK ── -->
                <Grid RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,56">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="16,*,16"
                          HeightRequest="16"
                          Margin="0,0,0,10">
                        <BoxView Grid.Column="0" HeightRequest="1" WidthRequest="16"
                                 BackgroundColor="{StaticResource VE_GoldDim}"
                                 HorizontalOptions="Start" VerticalOptions="Center"/>
                        <BoxView Grid.Column="2" HeightRequest="1" WidthRequest="16"
                                 BackgroundColor="{StaticResource VE_GoldDim}"
                                 HorizontalOptions="End" VerticalOptions="Center"/>
                    </Grid>
                    <Label Grid.Row="1"
                           Text="VISION"
                           FontFamily="DisplayFont"
                           FontSize="52"
                           CharacterSpacing="14"
                           TextColor="{StaticResource VE_Text1}"
                           HorizontalOptions="Center"/>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
                        <BoxView Grid.Column="0" HeightRequest="1"
                                 BackgroundColor="{StaticResource VE_Divider}"
                                 VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1"
                               Text="EDIT"
                               FontFamily="SpaceMono"
                               FontSize="11"
                               CharacterSpacing="8"
                               TextColor="{StaticResource VE_Gold}"
                               VerticalOptions="Center"/>
                        <BoxView Grid.Column="2" HeightRequest="1"
                                 BackgroundColor="{StaticResource VE_Divider}"
                                 VerticalOptions="Center" Margin="12,0,0,0"/>
                    </Grid>
                </Grid>

                <!-- ── HERO TAGLINE ── -->
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,0,0,52">
                    <Label Text="AI-powered writing for the uncompromising creator."
                           FontFamily="SerifFont"
                           FontSize="20"
                           FontAttributes="Italic"
                           TextColor="{StaticResource VE_Text2}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           MaximumWidthRequest="320"/>
                </VerticalStackLayout>

                <!-- ── FEATURE SECTION LABEL ── -->
                <Grid ColumnDefinitions="*,Auto,*" Margin="0,0,0,24">
                    <BoxView Grid.Column="0" HeightRequest="1"
                             BackgroundColor="{StaticResource VE_Divider}"
                             VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="WHAT YOU GET"
                           FontFamily="SpaceMono"
                           FontSize="9"
                           CharacterSpacing="4"
                           TextColor="{StaticResource VE_Text4}"
                           Margin="12,0"/>
                    <BoxView Grid.Column="2" HeightRequest="1"
                             BackgroundColor="{StaticResource VE_Divider}"
                             VerticalOptions="Center"/>
                </Grid>

                <!-- ── FEATURE CARDS ── -->
                <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,10,Auto" Margin="0,0,0,40">

                    <!-- Fast Editing -->
                    <Border Grid.Row="0" Grid.Column="0"
                            BackgroundColor="{StaticResource VE_BgCard}"
                            Stroke="{StaticResource VE_Border2}"
                            StrokeThickness="1"
                            Padding="20,22">
                        <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <!-- Gold accent bar -->
                            <BoxView HeightRequest="2" WidthRequest="24"
                                     BackgroundColor="{StaticResource VE_Gold}"
                                     HorizontalOptions="Start"/>
                            <Label Text="FAST EDITING"
                                   FontFamily="SpaceMono"
                                   FontSize="10"
                                   CharacterSpacing="3"
                                   TextColor="{StaticResource VE_Text1}"/>
                            <Label Text="Write and revise at the speed of thought. Zero friction."
                                   FontFamily="SpaceMono"
                                   FontSize="11"
                                   TextColor="{StaticResource VE_Text3}"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- AI Assistant -->
                    <Border Grid.Row="0" Grid.Column="2"
                            BackgroundColor="{StaticResource VE_BgCard}"
                            Stroke="{StaticResource VE_Border2}"
                            StrokeThickness="1"
                            Padding="20,22">
                        <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <BoxView HeightRequest="2" WidthRequest="24"
                                     BackgroundColor="{StaticResource VE_Gold}"
                                     HorizontalOptions="Start"/>
                            <Label Text="AI ASSISTANT"
                                   FontFamily="SpaceMono"
                                   FontSize="10"
                                   CharacterSpacing="3"
                                   TextColor="{StaticResource VE_Text1}"/>
                            <Label Text="Intelligent completions that feel like intuition."
                                   FontFamily="SpaceMono"
                                   FontSize="11"
                                   TextColor="{StaticResource VE_Text3}"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Cloud Sync -->
                    <Border Grid.Row="2" Grid.Column="0"
                            BackgroundColor="{StaticResource VE_BgCard}"
                            Stroke="{StaticResource VE_Border2}"
                            StrokeThickness="1"
                            Padding="20,22">
                        <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <BoxView HeightRequest="2" WidthRequest="24"
                                     BackgroundColor="{StaticResource VE_GoldDim}"
                                     HorizontalOptions="Start"/>
                            <Label Text="CLOUD SYNC"
                                   FontFamily="SpaceMono"
                                   FontSize="10"
                                   CharacterSpacing="3"
                                   TextColor="{StaticResource VE_Text1}"/>
                            <Label Text="Your work follows you everywhere, always current."
                                   FontFamily="SpaceMono"
                                   FontSize="11"
                                   TextColor="{StaticResource VE_Text3}"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Secure -->
                    <Border Grid.Row="2" Grid.Column="2"
                            BackgroundColor="{StaticResource VE_BgCard}"
                            Stroke="{StaticResource VE_Border2}"
                            StrokeThickness="1"
                            Padding="20,22">
                        <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <BoxView HeightRequest="2" WidthRequest="24"
                                     BackgroundColor="{StaticResource VE_GoldDim}"
                                     HorizontalOptions="Start"/>
                            <Label Text="SECURE"
                                   FontFamily="SpaceMono"
                                   FontSize="10"
                                   CharacterSpacing="3"
                                   TextColor="{StaticResource VE_Text1}"/>
                            <Label Text="End-to-end encryption. Your words belong to you."
                                   FontFamily="SpaceMono"
                                   FontSize="11"
                                   TextColor="{StaticResource VE_Text3}"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Spacer before CTA -->
                <BoxView HeightRequest="8" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── CTA FOOTER ── -->
        <VerticalStackLayout Grid.Row="1"
                             BackgroundColor="#0A0A0A"
                             Padding="36,20,36,36"
                             Spacing="12">
            <BoxView HeightRequest="1"
                     BackgroundColor="{StaticResource VE_Divider}"
                     Margin="0,0,0,4"/>

            <!-- Get Started -->
            <Button Text="GET STARTED"
                    Style="{StaticResource VE_BtnPrimary}"
                    HeightRequest="52"/>

            <!-- View Docs -->
            <Button Text="VIEW DOCUMENTATION"
                    Style="{StaticResource VE_BtnGhost}"
                    HeightRequest="46"/>

            <!-- Legal -->
            <Label Text="© 2026 Vision Edit Studio"
                   FontFamily="SpaceMono"
                   FontSize="9"
                   CharacterSpacing="1"
                   TextColor="{StaticResource VE_Text4}"
                   HorizontalOptions="Center"
                   Margin="0,4,0,0"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
