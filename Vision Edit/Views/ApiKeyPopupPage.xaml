<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vision_Edit.Views.ApiKeyPopupPage"
             Title="API Key Setup"
             BackgroundColor="{StaticResource VE_BgPanel}">

    <VerticalStackLayout
        Padding="20"
        Spacing="16"
        VerticalOptions="Center">

        <Label
            Text="OpenAI API Key"
            FontSize="24"
            FontAttributes="Bold"
            TextColor="{StaticResource VE_Text1}"
            HorizontalOptions="Center" />

        <Label
            Text="Enter your OpenAI API key to use AI features"
            FontSize="14"
            TextColor="{StaticResource VE_Text2}"
            HorizontalOptions="FillAndExpand"
            LineBreakMode="WordWrap" />

        <Entry
            x:Name="ApiKeyEntry"
            IsPassword="True"
            Placeholder="sk-..."
            PlaceholderColor="{StaticResource VE_Text4}"
            TextColor="{StaticResource VE_Text1}"
            FontSize="14" />

        <Label
            x:Name="ErrorLabel"
            TextColor="Red"
            IsVisible="False"
            FontSize="12"
            LineBreakMode="WordWrap" />

        <Label
            Text="Your API key is stored securely on your device and never sent to our servers."
            FontSize="11"
            TextColor="{StaticResource VE_Text3}"
            HorizontalOptions="FillAndExpand"
            LineBreakMode="WordWrap" />

        <HorizontalStackLayout
            Spacing="12"
            HorizontalOptions="FillAndExpand">
            <Button
                Text="Cancel"
                Clicked="OnCancelClicked"
                HorizontalOptions="Fill"
                BackgroundColor="{StaticResource VE_BgCard}" />
            <Button
                Text="Save"
                Clicked="OnSaveClicked"
                HorizontalOptions="Fill"
                BackgroundColor="{StaticResource VE_Gold}" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>
