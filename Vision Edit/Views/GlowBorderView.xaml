<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vision_Edit.Views.GlowBorderView">

    <!--
        GlowBorderView — reusable gold-accent border container.
        Wraps any content in a dark card with a subtle gold stroke
        and a warm gold ambient shadow. Drop any content inside to
        give it the Vision Edit signature frame.
    -->
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border Margin="10"
                    Padding="16"
                    BackgroundColor="#111111"
                    Stroke="#7A6248"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="3"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#C8A97E"
                            Radius="16"
                            Opacity="0.12"
                            Offset="0,4"/>
                </Border.Shadow>
                <ContentPresenter/>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
