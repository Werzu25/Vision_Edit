<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Vision_Edit.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Vision_Edit.Views"
    xmlns:viewmodels="clr-namespace:Vision_Edit.ViewModels"
    x:DataType="viewmodels:AppShellViewModel"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{StaticResource VE_BgPanel}"
    Shell.BackgroundColor="{StaticResource VE_BgPanel}"
    Shell.ForegroundColor="{StaticResource VE_Gold}"
    Shell.TitleColor="{StaticResource VE_Text1}"
    Shell.UnselectedColor="{StaticResource VE_Text3}"
    Shell.DisabledColor="{StaticResource VE_Text4}"
    Shell.NavBarHasShadow="False"
    Shell.TabBarBackgroundColor="{StaticResource VE_BgPanel}"
    Shell.TabBarForegroundColor="{StaticResource VE_Gold}"
    Shell.TabBarUnselectedColor="{StaticResource VE_Text3}"
    Title="Vision Edit">

    <Shell.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <Style x:Key="FlyoutItemStyle" TargetType="Grid">
                <Setter Property="BackgroundColor" Value="Transparent"/>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Custom flyout item template -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="40,*"
                  HeightRequest="44"
                  BackgroundColor="Transparent"
                  Padding="12,0">
                <Label Grid.Column="0"
                       Text="{Binding Icon}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource VE_Text3}"/>
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontFamily="OpenSansSemibold"
                       FontSize="12"
                       CharacterSpacing="1"
                       VerticalOptions="Center"
                       TextColor="{StaticResource VE_Text2}"/>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- Flyout Header -->
    <Shell.FlyoutHeader>
        <Grid RowDefinitions="Auto,1" BackgroundColor="{StaticResource VE_BgPanel}">
            <VerticalStackLayout Padding="20,20,20,16" Spacing="3">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <BoxView WidthRequest="3"
                             HeightRequest="16"
                             BackgroundColor="{StaticResource VE_GoldDim}"
                             VerticalOptions="Center"/>
                    <Label Text="VISION EDIT"
                           FontFamily="OpenSansSemibold"
                           FontSize="14"
                           CharacterSpacing="3"
                           TextColor="{StaticResource VE_Text1}"/>
                </HorizontalStackLayout>
                <Label Text="AI-powered document editor"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       TextColor="{StaticResource VE_Text4}"
                       Margin="11,0,0,0"/>
            </VerticalStackLayout>
            <BoxView Grid.Row="1" Color="{StaticResource VE_Border2}" HeightRequest="1"/>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Flyout Footer — only shown when logged in -->
    <Shell.FlyoutFooter>
        <Grid RowDefinitions="1,Auto"
              IsVisible="{Binding UserManager.IsLoggedIn}"
              BackgroundColor="{StaticResource VE_BgPanel}">
            <BoxView Grid.Row="0" Color="{StaticResource VE_Border2}" HeightRequest="1"/>
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto"
                  Padding="20,14">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding UserManager.Username}"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           TextColor="{StaticResource VE_Text1}"/>
                    <Label Text="Logged in"
                           FontFamily="OpenSansRegular"
                           FontSize="10"
                           TextColor="{StaticResource VE_Text4}"/>
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Sign out"
                        Command="{Binding LogoutCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource VE_GoldDim}"
                        FontFamily="OpenSansSemibold"
                        FontSize="10"
                        CharacterSpacing="1"
                        Padding="10,6"
                        MinimumHeightRequest="0"
                        HeightRequest="32"
                        BorderWidth="1"
                        BorderColor="{StaticResource VE_Border2}"
                        CornerRadius="3"/>
            </Grid>
        </Grid>
    </Shell.FlyoutFooter>

    <!-- ── Logged-in routes ── -->

    <!-- Workspace (default when logged in) -->
    <ShellContent
        Title="Workspace"
        Icon="⬛"
        ContentTemplate="{DataTemplate views:WorkspacePage}"
        IsVisible="{Binding UserManager.IsLoggedIn}"
        Route="Workspace"/>

    <!-- Standalone Editor -->
    <ShellContent
        Title="Editor"
        Icon="✏️"
        ContentTemplate="{DataTemplate views:EditorPage}"
        IsVisible="{Binding UserManager.IsLoggedIn}"
        Route="Editor"/>

    <!-- Standalone Chat -->
    <ShellContent
        Title="Chat"
        Icon="💬"
        ContentTemplate="{DataTemplate views:ChatPage}"
        IsVisible="{Binding UserManager.IsLoggedIn}"
        Route="Chat"/>

    <!-- ── Logged-out routes ── -->

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="Login"
        IsVisible="{Binding UserManager.IsLoggedIn, Converter={StaticResource InvertedBoolConverter}}"/>

    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate views:RegistrationPage}"
        Route="RegistrationPage"
        IsVisible="{Binding UserManager.IsLoggedIn, Converter={StaticResource InvertedBoolConverter}}"/>

    <ShellContent
        Title="Home"
        Icon="🏠"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage"/>

</Shell>
